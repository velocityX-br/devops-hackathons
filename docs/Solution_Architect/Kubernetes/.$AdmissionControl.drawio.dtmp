        <mxCell id="FTwm8UCfc6gtRTB6XrzO-1" value="&lt;span style=&quot;color: rgb(33, 37, 41); font-family: &amp;quot;Open Sans&amp;quot;, -apple-system, &amp;quot;system-ui&amp;quot;, &amp;quot;Segoe UI&amp;quot;, Roboto, &amp;quot;Helvetica Neue&amp;quot;, Arial, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;Admission webhooks are HTTP callbacks that receive admission requests and do something with them.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="-160" y="110" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="FTwm8UCfc6gtRTB6XrzO-2" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Dynamic Admission Control&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="-70" y="80" width="360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-9" value="ETCD" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;" vertex="1" parent="1">
          <mxGeometry x="-390" y="570" width="110" height="80" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="MbU5uru1sVN3UMceqhsn-6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="75" y="820" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-11" value="&lt;div&gt;Allowed:true + go handleDNSManagement&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="JT2s3ODVslsfIcApS96u-10">
          <mxGeometry x="-0.1" y="2" relative="1" as="geometry">
            <mxPoint x="25" y="3" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-14" value="Drop" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="335" y="780" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-16" value="&lt;div&gt;CRD Metadata:&lt;/div&gt;1. Rule in resources: svc/ingress/vs/gw&lt;div&gt;2.&amp;nbsp;Ignore + timeout:10&lt;/div&gt;&lt;div&gt;3.&amp;nbsp;namespaceSelector&lt;/div&gt;&lt;div&gt;4. f&lt;span style=&quot;font-size: 11px; text-wrap-mode: nowrap; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ailurePolicy: Ignore&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 11px; text-wrap-mode: nowrap; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;5.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 11px; text-wrap-mode: nowrap; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;matchPolicy: Equivalent&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="620" y="500" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-20" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; ① 准入投票 Allowed:true&amp;nbsp; → API Server 把【原始 Service 对象】写进 etcd&lt;/b&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (annotation 原样保存,status 仍为空,无任何 webhook 附加字段)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; ② go handleDNSManagement → 异步调 GMP HTTP API 建 A 记录&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (写的是【外部 GMP 系统】,跟 etcd 毫无关系)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; - etcd 里:只有那个普通的 Service 对象。DNS 注解作为用户自己写的 annotation被保存,但 webhook 没有因此往对象里塞任何东西(没有 finalizer、没有 status patch、没有额外 annotation)。&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; - GMP 里:A 记录 = FQDN → IP。这是对外部 DNS 系统的副作用,kubectl get svc -o yaml 里看不到它。&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; 四、一句话总结&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; Allowed:true 不写 etcd,只是放行——真正写进 etcd 的是用户提交的原始对象,webhook 一字未改(validating 阶段本就无权改,响应里没有 patch)。而 A 记录建在外部 GMP,是异步副作用,与 etcd 无关。所以 Allowed:true 的效果是:etcd&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&amp;nbsp; 得到原对象 + GMP(异步)得到一条 A 记录,两者互不干涉。&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(204, 0, 0);&quot;&gt;&lt;font color=&quot;#cc0000&quot;&gt;&lt;b&gt;在这里，VWC 的价值正是提供了那个其他机制给不了的&quot;最早触发点&quot;,而把可靠性交给 informer。&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="-10" y="900" width="700" height="270" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-21" value="Asynchronously&amp;nbsp; Call GMP-API to create A record" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-10" y="820" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="JT2s3ODVslsfIcApS96u-22" value="The following diagram depicts a non-typical VWC. It takes the advantage of being involved (&quot;/validate&quot;) before persisting to ETCD to sense the resources that contains the specific DNS annotations&amp;nbsp; and asynchronously create A record" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="140" y="180" width="460" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
