        <mxCell id="y-woEJmO1qLSLA19WQWR-50" value="&lt;div&gt;&amp;nbsp; annotations:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; cert-manager.io/inject-ca-from: cosign-validator/cosign-webhook-cert&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
