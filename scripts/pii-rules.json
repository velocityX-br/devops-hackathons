{
  "$schema": "./pii-rules.schema.json",
  "description": "企业 PII / 敏感信息检测规则，用于阻止公开发布到 GitHub Pages",
  "scanPaths": [
    "blog",
    "docs",
    "src",
    "static",
    "i18n"
  ],
  "scanExtensions": [".md", ".mdx", ".json", ".yml", ".yaml", ".js", ".ts", ".tsx", ".css"],
  "ignorePaths": [
    "node_modules",
    "build",
    ".docusaurus",
    "i18n/**/code.json"
  ],
  "placeholderPatterns": [
    "<[^>]+>",
    "\\$\\{[^}]+\\}",
    "\\$[A-Z_][A-Z0-9_]*",
    "your[_-]?password",
    "your[_-]?vault[_-]?token",
    "example\\.com",
    "dummy\\.com",
    "placeholder",
    "REDACTED",
    "xxx+",
    "\\*\\*\\*+",
    "ms-00000000-0000-4000-8000-[0-9a-f]{12}",
    "00000000-0000-4000-8000-[0-9a-f]{12}",
    "<same-secret-as-[^>]+>",
    "<[^>]*secret[^>]*>",
    "<[^>]*token[^>]*>",
    "<[^>]*password[^>]*>"
  ],
  "rules": [
    {
      "id": "brand-sap",
      "name": "企业品牌名 SAP",
      "severity": "medium",
      "description": "公开内容中的企业品牌字样 SAP / Sap（域名由 brand-sap-domain 处理）",
      "pattern": "\\bS[Aa][Pp]\\b",
      "flags": "g",
      "hint": "替换为 PPP",
      "replacement": "PPP",
      "applyOnPlaceholderLines": true
    },
    {
      "id": "brand-sap-domain",
      "name": "企业品牌域名 *.sap.com / *.cloud.sap / *.tools.sap",
      "severity": "medium",
      "description": "公开内容中的企业品牌域名（*.sap.com、*.cloud.sap、*.tools.sap）",
      "pattern": "(?:https?://)?(?:[a-zA-Z0-9-]+\\.)+sap\\.com(?:/[^\\s\"')\\]]*)?|(?:https?://)?(?:[a-zA-Z0-9-]+\\.)*(?:cloud|tools)\\.sap(?:/[^\\s\"')\\]]*)?",
      "flags": "g",
      "hint": "替换为 example.com（仅替换主机名片段，避免破坏 dashboard.<region>.… 一类占位 URL）",
      "replacement": "example.com",
      "applyOnPlaceholderLines": true
    },
    {
      "id": "brand-sap-prefix",
      "name": "企业品牌前缀 sap-",
      "severity": "medium",
      "description": "公开内容中以 sap- 开头的包名/技能名/模型名",
      "pattern": "\\bsap-",
      "flags": "g",
      "hint": "替换为 ppp-",
      "replacement": "ppp-",
      "applyOnPlaceholderLines": true
    },
    {
      "id": "brand-converged-cloud",
      "name": "产品名 Converged Cloud",
      "severity": "medium",
      "description": "公开内容中的产品名 Converged Cloud",
      "pattern": "Converged Cloud",
      "flags": "g",
      "hint": "替换为 C Cloud",
      "replacement": "C Cloud",
      "applyOnPlaceholderLines": true
    },
    {
      "id": "sap-user-id",
      "name": "企业用户 ID",
      "severity": "high",
      "description": "企业员工/系统用户 ID（如 I123456、C123456）",
      "pattern": "\\b[ICD][0-9]{6,8}\\b",
      "hint": "替换为 <USER_ID> 或虚构 ID（如 I000000）",
      "replacement": "<USER_ID>"
    },
    {
      "id": "corporate-email",
      "name": "企业邮箱",
      "severity": "high",
      "description": "企业内部邮箱地址（含 sap.com / pppdemands.com 等）",
      "pattern": "[a-zA-Z0-9._%+-]+@(?:sap\\.com|pppdemands\\.com|global\\.pppdemands\\.com|cia\\.net\\.pppdemands\\.com|od\\.pppdemands\\.com)",
      "hint": "替换为 user@example.com 或 svc-account@example.com",
      "replacement": "user@example.com"
    },
    {
      "id": "client-secret-value",
      "name": "OAuth Client Secret",
      "severity": "critical",
      "description": "OIDC/OAuth clientSecret 明文值",
      "pattern": "clientSecret:\\s*[0-9a-fA-F]{16,}",
      "hint": "替换为 clientSecret: <CLIENT_SECRET> 或从 Vault 引用",
      "replacement": "clientSecret: <CLIENT_SECRET>"
    },
    {
      "id": "json-credential",
      "name": "JSON 凭证字段",
      "severity": "critical",
      "description": "JSON 中的密钥/密码明文（AICORE_CLIENT_SECRET、password 等）",
      "pattern": "\"(?:AICORE_CLIENT_(?:ID|SECRET)|client_secret|api_key|private_key|access_token|refresh_token|password|secret_id|secret-id)\"\\s*:\\s*\"[^\"\\s<][^\"]{7,}\"",
      "hint": "使用占位符或环境变量引用，勿写入真实值",
      "replacement": "$1\"<REDACTED>\"",
      "captureRewrite": "(\"(?:AICORE_CLIENT_(?:ID|SECRET)|client_secret|api_key|private_key|access_token|refresh_token|password|secret_id|secret-id)\"\\s*:\\s*)\"[^\"\\s<][^\"]{7,}\""
    },
    {
      "id": "dns-tsig-secret",
      "name": "DNS TSIG Secret",
      "severity": "critical",
      "description": "BIND DNS TSIG 共享密钥",
      "pattern": "secret\\s+\"[A-Za-z0-9+/]{20,}={0,2}\"",
      "hint": "替换为 secret \"<TSIG_SECRET>\"; 并注明从 dnssec-keygen 生成",
      "replacement": "secret \"<TSIG_SECRET>\""
    },
    {
      "id": "home-path-user-id",
      "name": "含用户 ID 的本地路径",
      "severity": "high",
      "description": "包含真实企业用户 ID 的本地文件路径",
      "pattern": "/(?:Users|home)/[ICD][0-9]{6,8}/",
      "hint": "替换为 /Users/<USER_ID>/ 或 ~/project/",
      "replacement": "/Users/<USER_ID>/"
    },
    {
      "id": "internal-github-url",
      "name": "企业内部 GitHub URL",
      "severity": "medium",
      "description": "指向企业内部 GitHub 实例的 URL",
      "pattern": "https?://github(?:\\.tools)?\\.pppdemands\\.com/[^\\s\"')\\]]+",
      "hint": "替换为 https://example.com/internal-github/...（勿用含 <> 的占位符，MDX 无法解析链接）",
      "replacement": "https://example.com/internal-github/redacted"
    },
    {
      "id": "internal-pages-url",
      "name": "企业内部 Pages URL",
      "severity": "medium",
      "description": "指向企业内部文档站点的 URL",
      "pattern": "https?://pages\\.github\\.tools\\.pppdemands\\.com/[^\\s\"')\\]]+",
      "hint": "替换为 https://example.com/internal-pages/...（勿用含 <> 的占位符，MDX 无法解析链接）",
      "replacement": "https://example.com/internal-pages/redacted"
    },
    {
      "id": "internal-registry",
      "name": "企业内部镜像仓库",
      "severity": "medium",
      "description": "企业内部 Docker/镜像仓库地址",
      "pattern": "[a-zA-Z0-9.-]+\\.repositories\\.cloud\\.pppdemands\\.com/[^\\s\"')\\]]+",
      "hint": "替换为 <internal-registry>/image:tag",
      "replacement": "<internal-registry>/image:tag"
    },
    {
      "id": "bearer-token",
      "name": "Bearer Token",
      "severity": "critical",
      "description": "HTTP Authorization Bearer 令牌明文",
      "pattern": "Bearer\\s+[A-Za-z0-9._-]{30,}",
      "hint": "替换为 Bearer <TOKEN>",
      "replacement": "Bearer <TOKEN>"
    },
    {
      "id": "aws-access-key",
      "name": "AWS Access Key",
      "severity": "critical",
      "description": "AWS 访问密钥 ID",
      "pattern": "AKIA[0-9A-Z]{16}",
      "hint": "立即轮换密钥并使用占位符",
      "replacement": "<AWS_ACCESS_KEY_ID>"
    },
    {
      "id": "private-key-block",
      "name": "PEM 私钥",
      "severity": "critical",
      "description": "PEM 格式私钥块",
      "pattern": "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
      "hint": "绝不可提交私钥；使用密钥管理服务",
      "replacement": "-----BEGIN PRIVATE KEY----- <REDACTED>"
    },
    {
      "id": "ldap-bind-password",
      "name": "LDAP 绑定密码",
      "severity": "high",
      "description": "LDAP 命令中的明文密码参数",
      "pattern": "-w\\s+['\"][^'\"\\s$][^'\"]{3,}['\"]",
      "flags": "g",
      "hint": "使用 -W（交互提示）或 $LDAP_PASSWORD 环境变量",
      "replacement": "-w \"$LDAP_PASSWORD\""
    }
  ]
}
